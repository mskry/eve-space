  "server": {
    "package": "@eve-space/member-audit-server",
    "routes": [
      {
        "id": "member-summary",
        "namespace": "/member-audit/accounts/:userId/summary",
        "exportName": "memberSummaryRoutes",
        "authorization": "authenticated-session",
        "audience": "hr",
        "requiredPermission": "member-audit.summary.read",
        "persistenceOperations": [],
        "sectionId": "overview",
        "target": "managed-organization-account",
        "exposure": "standard"
      },
      {
        "id": "character-overview",
        "namespace": "/member-audit/accounts/:userId/characters/:characterId/overview",
        "exportName": "memberCharacterOverviewRoutes",
        "authorization": "authenticated-session",
        "audience": "hr",
        "requiredPermission": "member-audit.summary.read",
        "coreDataProducts": ["public-character-profile"],
        "persistenceOperations": [],
        "sectionId": "overview",
        "target": "managed-organization-character",
        "exposure": "standard"
      },
      {
        "id": "current-observation-detail",
        "namespace": "/member-audit/accounts/:userId/characters/:characterId/current-observation",
        "exportName": "memberCurrentObservationRoutes",
        "authorization": "authenticated-session",
        "audience": "hr",
        "requiredPermission": "member-audit.current-observation.read",
        "persistenceOperations": [{ "operationId": "read-current-observation" }],
        "sectionId": "current-observation",
        "target": "managed-organization-character",
        "exposure": "sensitive-evidence",
        "reviewerEvidenceResources": [
          { "resourceId": "current-ship", "field": "currentShip" },
          { "resourceId": "current-location", "field": "currentLocation" }
        ]
      },
      {
        "id": "skills-detail",
        "namespace": "/member-audit/accounts/:userId/characters/:characterId/skills",
        "exportName": "memberSkillsRoutes",
        "authorization": "authenticated-session",
        "audience": "hr",
        "requiredPermission": "member-audit.skills.read",
        "persistenceOperations": [
          {
            "operationId": "read-trained-skills-evidence"
          }
        ],
        "sectionId": "skills",
        "target": "managed-organization-character",
        "exposure": "sensitive-evidence",
        "reviewerEvidenceResources": [{ "resourceId": "trained-skills", "field": "trainedSkills" }]
      },
      {
        "id": "assets-detail",
        "namespace": "/member-audit/accounts/:userId/characters/:characterId/assets",
        "exportName": "memberAssetsRoutes",
        "authorization": "authenticated-session",
        "audience": "hr",
        "requiredPermission": "member-audit.assets.read",
        "persistenceOperations": [
          {
            "operationId": "read-asset-evidence"
          }
        ],
        "sectionId": "assets",
        "target": "managed-organization-character",
        "exposure": "sensitive-evidence",
        "reviewerEvidenceResources": [{ "resourceId": "assets", "field": null }]
      },
      {
        "id": "wallet-detail",
        "namespace": "/member-audit/accounts/:userId/characters/:characterId/wallet",
        "exportName": "memberWalletRoutes",
        "authorization": "authenticated-session",
        "audience": "hr",
        "requiredPermission": "member-audit.wallet.read",
        "persistenceOperations": [
          {
            "operationId": "read-wallet-evidence"
          }
        ],
        "sectionId": "wallet",
        "target": "managed-organization-character",
        "exposure": "sensitive-evidence",
        "reviewerEvidenceResources": [
          { "resourceId": "wallet-balance", "field": "balance" },
          { "resourceId": "wallet-journal", "field": "journal" },
          { "resourceId": "wallet-transactions", "field": "transactions" }
        ]
      },
      {
        "id": "mail-detail",
        "namespace": "/member-audit/accounts/:userId/characters/:characterId/mail",
        "exportName": "memberMailRoutes",
        "authorization": "authenticated-session",
        "audience": "hr",
        "requiredPermission": "member-audit.mail.read",
        "persistenceOperations": [
          {
            "operationId": "read-mail-evidence"
          }
        ],
        "sectionId": "mail",
        "target": "managed-organization-character",
        "exposure": "sensitive-evidence",
        "reviewerEvidenceResources": [
          { "resourceId": "mail-headers", "field": "headers" },
          { "resourceId": "mail-details", "field": "contents" }
        ]
      },
      {
        "id": "group-actions",
        "namespace": "/member-audit/accounts/:userId/groups",
        "exportName": "memberGroupRoutes",
        "authorization": "authenticated-session",
        "audience": "hr",
        "requiredPermission": "member-audit.groups.manage",
        "persistenceOperations": [],
        "sectionId": "access-management",
        "target": "managed-organization-account",
        "exposure": "standard",
        "organizationCommands": ["assign-ordinary-group", "revoke-ordinary-group"]
      },
      {
        "id": "block-actions",
        "namespace": "/member-audit/accounts/:userId/block",
        "exportName": "memberBlockRoutes",
        "authorization": "authenticated-session",
        "audience": "hr",
        "requiredPermission": "member-audit.members.block",
        "persistenceOperations": [],
        "sectionId": "access-management",
        "target": "managed-organization-account",
        "exposure": "standard",
        "organizationCommands": ["block-member", "unblock-member"]
      }
    ],

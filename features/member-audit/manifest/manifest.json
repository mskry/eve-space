{
  "id": "member-audit",
  "release": {
    "publisherPackage": "@eve-space/member-audit-manifest",
    "version": "0.1.0",
    "hostContractRange": "^1.0.0"
  },
  "icon": "corporation",
  "defaultEnabled": false,
  "permissions": [
    {
      "key": "member-audit.assets.read",
      "label": "View member assets",
      "purpose": "View sensitive asset evidence for managed member characters.",
      "audiences": ["director", "hr"],
      "sensitivity": "sensitive",
      "reviewAllowed": false
    },
    {
      "key": "member-audit.current-observation.read",
      "label": "View current ship and location",
      "purpose": "View separately authorized current ship and location snapshots for managed member characters.",
      "audiences": ["director", "hr"],
      "sensitivity": "sensitive",
      "reviewAllowed": false
    },
    {
      "key": "member-audit.groups.manage",
      "label": "Manage ordinary groups",
      "purpose": "Assign and revoke ordinary groups for managed members.",
      "audiences": ["director", "hr"],
      "sensitivity": "sensitive",
      "reviewAllowed": false
    },
    {
      "key": "member-audit.mail.read",
      "label": "View member mail",
      "purpose": "View sensitive mail evidence for managed member characters.",
      "audiences": ["director", "hr"],
      "sensitivity": "sensitive",
      "reviewAllowed": false
    },
    {
      "key": "member-audit.members.block",
      "label": "Manage member blocks",
      "purpose": "Block and unblock managed members from organization access.",
      "audiences": ["director", "hr"],
      "sensitivity": "sensitive",
      "reviewAllowed": false
    },
    {
      "key": "member-audit.search",
      "label": "Search managed members",
      "purpose": "Find managed organization accounts for review.",
      "audiences": ["director", "hr"],
      "sensitivity": "standard",
      "reviewAllowed": false
    },
    {
      "key": "member-audit.skills.read",
      "label": "View member skills",
      "purpose": "View sensitive trained-skill evidence for managed member characters.",
      "audiences": ["director", "hr"],
      "sensitivity": "sensitive",
      "reviewAllowed": false
    },
    {
      "key": "member-audit.summary.read",
      "label": "View member summaries",
      "purpose": "View a managed member summary and evidence availability.",
      "audiences": ["director", "hr"],
      "sensitivity": "standard",
      "reviewAllowed": false
    },
    {
      "key": "member-audit.wallet.read",
      "label": "View member wallet",
      "purpose": "View sensitive wallet evidence for managed member characters.",
      "audiences": ["director", "hr"],
      "sensitivity": "sensitive",
      "reviewAllowed": false
    }
  ],
  "permissionProfiles": [
    {
      "id": "access-management",
      "label": "Access management",
      "description": "Suggested access to review members and manage ordinary groups and blocks.",
      "audiences": ["director", "hr"],
      "permissions": [
        "member-audit.groups.manage",
        "member-audit.members.block",
        "member-audit.search",
        "member-audit.summary.read"
      ]
    },
    {
      "id": "evidence-review",
      "label": "Evidence review",
      "description": "Suggested access to review all sensitive Member Audit evidence sections.",
      "audiences": ["director", "hr"],
      "permissions": [
        "member-audit.assets.read",
        "member-audit.mail.read",
        "member-audit.search",
        "member-audit.skills.read",
        "member-audit.summary.read",
        "member-audit.wallet.read"
      ]
    },
    {
      "id": "member-review",
      "label": "Member review",
      "description": "Suggested access to find managed members and review their bounded summary.",
      "audiences": ["director", "hr"],
      "permissions": ["member-audit.search", "member-audit.summary.read"]
    }
  ],
  "reviewerContributions": [
    {
      "id": "overview",
      "directoryAction": "review",
      "routeId": "member-summary",
      "directoryPermission": "member-audit.search",
      "audience": "hr",
      "requiredPermission": "member-audit.summary.read",
      "target": "managed-organization-account",
      "panelExport": "./reviewer/overview",
      "label": "Member overview",
      "description": "Review identity, compliance, access, and evidence availability.",
      "icon": "overview",
      "order": 100
    },
    {
      "id": "character-landing-profile",
      "directoryAction": "review",
      "routeId": "character-overview",
      "directoryPermission": "member-audit.search",
      "audience": "hr",
      "requiredPermission": "member-audit.summary.read",
      "target": "managed-organization-character",
      "placement": "character-landing",
      "panelExport": "./reviewer/character-overview",
      "label": "Character profile",
      "description": "Read-only public profile for one exact disclosed character.",
      "icon": "character",
      "order": 105
    },
    {
      "id": "current-observation",
      "directoryAction": "review",
      "routeId": "current-observation-detail",
      "directoryPermission": "member-audit.search",
      "audience": "hr",
      "requiredPermission": "member-audit.current-observation.read",
      "target": "managed-organization-character",
      "placement": "character-landing",
      "panelExport": "./reviewer/current-observation",
      "label": "Current ship and location",
      "description": "Independently authorized current ship and location snapshots.",
      "icon": "location",
      "order": 106
    },
    {
      "id": "trained-skills",
      "directoryAction": "review",
      "routeId": "skills-detail",
      "directoryPermission": "member-audit.search",
      "audience": "hr",
      "requiredPermission": "member-audit.skills.read",
      "target": "managed-organization-character",
      "panelExport": "./reviewer/trained-skills",
      "label": "Trained skills",
      "description": "Review current trained-skill evidence for one disclosed character.",
      "icon": "character",
      "order": 110
    },
    {
      "id": "assets",
      "directoryAction": "review",
      "routeId": "assets-detail",
      "directoryPermission": "member-audit.search",
      "audience": "hr",
      "requiredPermission": "member-audit.assets.read",
      "target": "managed-organization-character",
      "panelExport": "./reviewer/assets",
      "label": "Assets",
      "description": "Review current asset evidence for one disclosed character.",
      "icon": "ship",
      "order": 120
    },
    {
      "id": "wallet",
      "directoryAction": "review",
      "routeId": "wallet-detail",
      "directoryPermission": "member-audit.search",
      "audience": "hr",
      "requiredPermission": "member-audit.wallet.read",
      "target": "managed-organization-character",
      "panelExport": "./reviewer/wallet",
      "label": "Wallet",
      "description": "Review wallet balance, journal, and transaction evidence.",
      "icon": "wallet",
      "order": 130
    },
    {
      "id": "mail",
      "directoryAction": "review",
      "routeId": "mail-detail",
      "directoryPermission": "member-audit.search",
      "audience": "hr",
      "requiredPermission": "member-audit.mail.read",
      "target": "managed-organization-character",
      "panelExport": "./reviewer/mail",
      "label": "Mail",
      "description": "Review retained sanitized mail evidence for one disclosed character.",
      "icon": "mail",
      "order": 140
    },
    {
      "id": "ordinary-groups",
      "routeId": "group-actions",
      "directoryPermission": "member-audit.search",
      "audience": "hr",
      "requiredPermission": "member-audit.groups.manage",
      "target": "managed-organization-account",
      "panelExport": "./reviewer/ordinary-groups",
      "label": "Ordinary groups",
      "description": "Assign or revoke non-restricted ordinary group access.",
      "icon": "settings",
      "order": 150
    },
    {
      "id": "member-block",
      "directoryAction": "manage-account",
      "routeId": "block-actions",
      "directoryPermission": "member-audit.search",
      "audience": "hr",
      "requiredPermission": "member-audit.members.block",
      "target": "managed-organization-account",
      "panelExport": "./reviewer/member-block",
      "label": "Member block",
      "description": "Block or unblock organization access with an audited reason.",
      "icon": "auth",
      "order": 160
    }
  ],
  "sections": [
    {
      "id": "overview",
      "kind": "workspace",
      "defaultEnabled": false
    },
    {
      "id": "skills",
      "kind": "sensitive-evidence",
      "defaultEnabled": false,
      "disclosureRevision": 2
    },
    {
      "id": "assets",
      "kind": "sensitive-evidence",
      "defaultEnabled": false,
      "disclosureRevision": 1
    },
    {
      "id": "wallet",
      "kind": "sensitive-evidence",
      "defaultEnabled": false,
      "disclosureRevision": 1
    },
    {
      "id": "mail",

{
  "id": "member-audit",
  "release": {
    "publisherPackage": "@eve-space/member-audit-manifest",
    "version": "0.1.0",
    "hostContractRange": "^1.0.0"
  },
  "icon": "corporation",
  "defaultEnabled": false,
  "permissions": [
    {
      "key": "member-audit.search",
      "label": "Search managed members",
      "purpose": "Find managed organization accounts for review.",
      "audiences": ["hr"],
      "sensitivity": "standard",
      "reviewAllowed": false
    },
    {
      "key": "member-audit.summary.read",
      "label": "View member summaries",
      "purpose": "View a managed member summary and evidence availability.",
      "audiences": ["hr"],
      "sensitivity": "standard",
      "reviewAllowed": false
    },
    {
      "key": "member-audit.skills.read",
      "label": "View member skills",
      "purpose": "View sensitive trained-skill evidence for managed member characters.",
      "audiences": ["hr"],
      "sensitivity": "sensitive",
      "reviewAllowed": false
    },
    {
      "key": "member-audit.assets.read",
      "label": "View member assets",
      "purpose": "View sensitive asset evidence for managed member characters.",
      "audiences": ["hr"],
      "sensitivity": "sensitive",
      "reviewAllowed": false
    },
    {
      "key": "member-audit.wallet.read",
      "label": "View member wallet",
      "purpose": "View sensitive wallet evidence for managed member characters.",
      "audiences": ["hr"],
      "sensitivity": "sensitive",
      "reviewAllowed": false
    },
    {
      "key": "member-audit.mail.read",
      "label": "View member mail",
      "purpose": "View sensitive mail evidence for managed member characters.",
      "audiences": ["hr"],
      "sensitivity": "sensitive",
      "reviewAllowed": false
    },
    {
      "key": "member-audit.groups.manage",
      "label": "Manage ordinary groups",
      "purpose": "Assign and revoke ordinary groups for managed members.",
      "audiences": ["hr"],
      "sensitivity": "sensitive",
      "reviewAllowed": false
    },
    {
      "key": "member-audit.members.block",
      "label": "Manage member blocks",
      "purpose": "Block and unblock managed members from organization access.",
      "audiences": ["hr"],
      "sensitivity": "sensitive",
      "reviewAllowed": false
    }
  ],
  "sections": [
    {
      "id": "overview",
      "kind": "workspace",
      "defaultEnabled": false
    },
    {
      "id": "skills",
      "kind": "sensitive-evidence",
      "defaultEnabled": false,
      "disclosureRevision": 1
    },
    {
      "id": "assets",
      "kind": "sensitive-evidence",
      "defaultEnabled": false,
      "disclosureRevision": 1
    },
    {
      "id": "wallet",
      "kind": "sensitive-evidence",
      "defaultEnabled": false,
      "disclosureRevision": 1
    },
    {
      "id": "mail",
      "kind": "sensitive-evidence",
      "defaultEnabled": false,
      "disclosureRevision": 1
    },
    {
      "id": "access-management",
      "kind": "access-management",
      "defaultEnabled": false
    }
  ],
  "server": {
    "package": "@eve-space/member-audit-server",
    "routes": [
      {
        "id": "member-search",
        "namespace": "/member-audit/search",
        "exportName": "memberSearchRoutes",
        "authorization": "authenticated-session",
        "audience": "hr",
        "requiredPermission": "member-audit.search",
        "additionalRequiredPermissions": ["member-audit.summary.read"],
        "persistenceOperations": [],
        "sectionId": "overview",
        "target": "managed-organization-account-search",
        "exposure": "standard"
      },
      {
        "id": "member-summary",
        "namespace": "/member-audit/accounts/:userId/summary",
        "exportName": "memberSummaryRoutes",
        "authorization": "authenticated-session",
        "audience": "hr",
        "requiredPermission": "member-audit.summary.read",
        "persistenceOperations": [],
        "sectionId": "overview",
        "target": "managed-organization-account",
        "exposure": "standard"
      },
      {
        "id": "skills-detail",
        "namespace": "/member-audit/accounts/:userId/characters/:characterId/skills",
        "exportName": "memberSkillsRoutes",
        "authorization": "authenticated-session",
        "audience": "hr",
        "requiredPermission": "member-audit.skills.read",
        "persistenceOperations": [
          {
            "operationId": "read-trained-skills-evidence"
          }
        ],
        "sectionId": "skills",
        "target": "managed-organization-character",
        "exposure": "sensitive-evidence",
        "reviewerEvidenceResourceId": "trained-skills"
      },
      {
        "id": "assets-detail",
        "namespace": "/member-audit/accounts/:userId/characters/:characterId/assets",
        "exportName": "memberAssetsRoutes",

{
  "id": "market",
  "release": {
    "publisherPackage": "@eve-space/market-manifest",
    "version": "0.1.0",
    "hostContractRange": "^1.0.0"
  },
  "icon": "market",
  "defaultEnabled": true,
  "permissions": [
    {
      "key": "market.structure.read",
      "label": "Read owned structure markets",
      "purpose": "View private structure orders through a current admitted owned character.",
      "audiences": ["member"],
      "sensitivity": "standard",
      "reviewAllowed": false
    }
  ],
  "server": {
    "package": "@eve-space/market-server",
    "routes": [
      {
        "id": "catalogue",
        "namespace": "/market/catalogue",
        "exportName": "catalogueRoutes",
        "authorization": "public",
        "coreDataProducts": ["market-catalogue"],
        "persistenceOperations": []
      },
      {
        "id": "profiles",
        "namespace": "/market/profiles",
        "exportName": "profileRoutes",
        "authorization": "deployment-administrator",
        "coreDataProducts": ["market-station-regions"],
        "persistenceOperations": [
          { "operationId": "list-market-profiles" },
          { "operationId": "save-market-profile" },
          { "operationId": "list-due-market-profiles" },
          { "operationId": "read-market-observation" }
        ]
      },
      {
        "id": "public-books",
        "namespace": "/market/books",
        "exportName": "marketBookRoutes",
        "authorization": "public",
        "coreDataProducts": ["static-location-labels"],
        "persistenceOperations": [
          { "operationId": "list-market-profiles" },
          { "operationId": "read-market-observation" },
          { "operationId": "read-market-replacement-status" },
          { "operationId": "read-market-order-rows" },
          { "operationId": "read-market-quote-rows" },
          { "operationId": "read-market-metrics" }
        ]
      },
      {
        "id": "reference-prices",
        "namespace": "/market/reference-prices",
        "exportName": "marketReferenceRoutes",
        "authorization": "public",
        "persistenceOperations": [{ "operationId": "read-market-reference-prices" }]
      },
      {
        "id": "daily-history",
        "namespace": "/market/history",
        "exportName": "marketHistoryRoutes",
        "authorization": "public",
        "persistenceOperations": [{ "operationId": "read-market-history" }]
      },
      {
        "id": "daily-history-demand",
        "namespace": "/market/history-intent",
        "exportName": "marketHistoryDemandRoutes",
        "authorization": "public-mutation",
        "onDemandProfileResourceId": "daily-history",
        "coreDataProducts": ["market-catalogue"],
        "persistenceOperations": [
          { "operationId": "list-market-profiles" },
          { "operationId": "read-market-history" },
          { "operationId": "request-market-history-demand" }
        ]
      },
      {
        "id": "private-structures",
        "namespace": "/market/characters/:characterId",
        "exportName": "marketStructureRoutes",
        "authorization": "owned-character",
        "audience": "member",
        "requiredPermission": "market.structure.read",
        "onDemandResourceId": "structure-orders",
        "persistenceOperations": [
          { "operationId": "read-structure-book" },
          { "operationId": "reserve-structure-demand" },
          { "operationId": "release-structure-demand" }
        ]
      },
      {
        "id": "quotes",
        "namespace": "/market/quotes",
        "exportName": "marketQuoteRoutes",
        "authorization": "public-mutation",
        "persistenceOperations": [
          { "operationId": "read-market-observation" },
          { "operationId": "read-market-quote-rows" }
        ]
      }
    ],
    "migrations": [
      { "name": "market-001-initial.sql" },
      { "name": "market-002-collected-publication.sql" }
    ],

  "nuxt": {
    "package": "@eve-space/market-nuxt",
    "pages": [
      {
        "id": "market",
        "name": "eve-market-overview",
        "path": "/market",
        "file": "src/runtime/app/pages/MarketPage.vue",
        "extensionPoint": "root",
        "audience": "public"
      }
    ],
    "navigation": [
      {
        "id": "market",
        "label": "Market",
        "description": "Browse published EVE items",
        "to": "/market",
        "audience": "public",
        "placement": "dashboard",
        "order": 15,
        "pageName": "eve-market-overview"
      }
    ]

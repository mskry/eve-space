{
  "name": "@eve-space/market-nuxt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.vue"
  ],
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    }
  },
  "files": [
    "dist",
    "src/runtime/app"
  ],
  "scripts": {
    "build": "pnpm typecheck:graphql && tsc6",
    "typecheck": "tsc6 --noEmit && pnpm typecheck:graphql",
    "typecheck:graphql": "tsc6 --noEmit --project tsconfig.graphql.json",
    "typecheck:runtime": "vue-tsc --noEmit --project tsconfig.runtime.json",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:fixtures": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@eve-space/platform-module-nuxt": "workspace:*",
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@pinia/colada": "catalog:",
    "fuse.js": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:vitest4",
    "typescript": "catalog:tsapi",
    "vitest": "catalog:vitest4",
    "vue-tsc": "catalog:"
  }
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    ".claude/**",
    ".nuxt/**",
    ".opencode/**",
    ".output/**",
    "coverage/**",
    "**/coverage/**",
    "dist/**",
    "**/dist/**",
    "node_modules/**",
    "openspec/**",
    "sde-ingest/target/**"
  ],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "overrides": [
    {
      "files": [
        "app/**/*.{ts,tsx,vue}",
        "layers/**/*.{ts,tsx,vue}",
        "packages/platform-module-nuxt/src/runtime/app/**/*.{ts,tsx,vue}",
        "features/*/nuxt/src/runtime/app/**/*.{ts,tsx,vue}"
      ],
      "env": {
        "browser": true,
        "vue": true
      }
    },
    {
      "files": [
        "api/**/*.{ts,mts}",
        "packages/platform-module-contract/**/*.{ts,mts}",
        "packages/platform-module-server/**/*.{ts,mts}",
        "packages/platform-module-nuxt/src/*.{ts,mts}",
        "features/*/server/**/*.{ts,mts}",
        "features/*/nuxt/src/module.{ts,mts}",
        "features/*/nuxt/test/fixtures/*/nuxt.config.{ts,mts}",
        "scripts/**/*.{ts,mts}",
        "*.{ts,mts}"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": ["api/src/db/migrate.ts"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.spec.ts"],
      "env": {
        "node": true,
        "vitest": true
      },
      "rules": {
        "no-await-in-loop": "off",
        "vitest/require-mock-type-parameters": "off"
      }
    }
  ],
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "node", "vue", "vitest"]
}

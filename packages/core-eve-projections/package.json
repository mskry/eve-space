    },
    "./mail": {
      "types": "./dist/mail.d.ts",
      "import": "./dist/mail.js"
    },
    "./skill-queue": {
      "types": "./dist/skill-queue.d.ts",
      "import": "./dist/skill-queue.js"
    },
    "./skill-training": {
      "types": "./dist/skill-training.d.ts",
      "import": "./dist/skill-training.js"
    },
    "./trained-skills": {
      "types": "./dist/trained-skills.d.ts",
      "import": "./dist/trained-skills.js"
    },
    "./wallet": {
      "types": "./dist/wallet.d.ts",
      "import": "./dist/wallet.js"

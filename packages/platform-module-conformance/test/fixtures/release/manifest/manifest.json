{
  "id": "fixture",
  "release": {
    "publisherPackage": "@example/fixture-manifest",
    "version": "1.2.3",
    "hostContractRange": "^1.1.0"
  },
  "icon": "overview",
  "defaultEnabled": false,
  "permissions": [
    {
      "key": "fixture.view",
      "label": "View fixture",
      "purpose": "Read fixture data",
      "audiences": ["member"],
      "sensitivity": "standard",
      "reviewAllowed": false
    }
  ],
  "server": {
    "package": "@example/fixture-server",
    "graphql": [
      {
        "id": "public-read",
        "exportName": "fixtureGraphQL",
        "rootField": "fixture",
        "types": ["FixtureRead"],
        "reads": [
          {
            "id": "root",
            "field": "Query.fixture",
            "strategy": "public",
            "cost": 1,
            "sourceCost": 0,
            "persistenceOperations": [],
            "coreDataProducts": []
          },
          {
            "id": "value",
            "field": "FixtureRead.value",
            "strategy": "public",
            "cost": 2,
            "sourceCost": 1,
            "persistenceOperations": [{ "operationId": "read-fixture" }],
            "coreDataProducts": []
          }
        ]
      }
    ],
    "routes": [
      {
        "id": "fixture-route",
        "namespace": "/fixture",
        "exportName": "fixtureRoutes",
        "authorization": "authenticated-session",
        "audience": "member",
        "requiredPermission": "fixture.view",
        "persistenceOperations": [{ "operationId": "read-fixture" }]
      }
    ],
    "migrations": [{ "name": "fixture-001.sql" }],
    "persistenceOperations": [
      {
        "id": "read-fixture",
        "method": "readFixture",
        "revision": 1,
        "mode": "read",
        "exportName": "readFixtureOperation",
        "migration": "fixture-001.sql"
      }
    ],
    "resources": [],
    "esiOperations": [],
    "activityProviders": [
      {
        "id": "fixture-provider",
        "exportName": "fixtureProvider",
        "audience": "member",
        "requiredPermission": "fixture.view",
        "persistenceOperations": [{ "operationId": "read-fixture" }],
        "freshness": { "staleAfterSeconds": 60 }
      }
    ]
  },
  "nuxt": {
    "package": "@example/fixture-nuxt",
    "pages": [
      {
        "id": "fixture-page",
        "name": "eve-fixture-page",
        "path": "/fixture",
        "file": "src/runtime/app/pages/FixturePage.vue",
        "extensionPoint": "root",
        "audience": "authenticated"
      }
    ],
    "navigation": [
      {
        "id": "fixture-navigation",
        "label": "Fixture",
        "description": "Fixture page",
        "to": "/fixture",
        "audience": "authenticated",
        "placement": "dashboard",
        "order": 90,
        "pageName": "eve-fixture-page"
      }
    ]
  }
}

{
  "name": "@eve-space/platform-module-nuxt",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "sideEffects": [
    "**/*.vue"
  ],
  "engines": {
    "node": ">=24.20.0"
  },
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./runtime/platform-api": {
      "types": "./dist/runtime/platform-api.d.ts",
      "import": "./dist/runtime/platform-api.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node ../../scripts/copy-platform-nuxt-runtime-assets.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:fixtures": "vitest run test/platform-module.nuxt.test.ts",
    "typecheck": "tsc --noEmit && nuxt typecheck test/fixtures/basic"
  },
  "dependencies": {
    "@eve-space/platform-module-contract": "workspace:*",
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:"
  },
  "devDependencies": {
    "@nuxt/test-utils": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:vitest4",
    "nuxt": "catalog:",
    "typescript": "catalog:tsapi",
    "vitest": "catalog:vitest4"
  },
  "peerDependencies": {
    "@pinia/colada": "catalog:",
    "hono": "catalog:",
    "vue": "catalog:"
  }
}

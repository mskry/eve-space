{
  "name": "@eve-space/platform-module-contract",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.20.0"
  },
  "exports": {
    "./activity": {
      "types": "./dist/activity.d.ts",
      "import": "./dist/activity.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js"
    },
    "./esi": {
      "types": "./dist/esi.d.ts",
      "import": "./dist/esi.js"
    },
    "./identifiers": {
      "types": "./dist/identifiers.d.ts",
      "import": "./dist/identifiers.js"
    },
    "./installed": {
      "types": "./dist/installed.d.ts",
      "import": "./dist/installed.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./persistence": {
      "types": "./dist/persistence.d.ts",
      "import": "./dist/persistence.js"
    },
    "./resources": {
      "types": "./dist/resources.d.ts",
      "import": "./dist/resources.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eve-space/core-data-contract": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:tsgo"
  }
}

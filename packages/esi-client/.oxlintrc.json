{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "src/generated/**",
    "tests/generated/**",
    "examples/generated/**",
    "dist/**",
    "node_modules/**",
    ".opencode/**",
    "openspec/**"
  ],
  "options": {
    "typeAware": true
  },
  "plugins": ["typescript", "unicorn", "oxc", "vitest", "node"]
}

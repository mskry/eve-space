{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "isolatedDeclarations": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "paths": {
      "@evespace/esi-client": ["./src/index.ts"],
      "@evespace/esi-client/domains/*": ["./src/generated/domains/*"],
      "@evespace/esi-client/operations": ["./src/operations.ts"],
      "@evespace/esi-client/types": ["./src/generated/types.gen.ts"],
      "@evespace/esi-client/zod": ["./src/generated/zod.gen.d.ts"]
    },
    "types": ["node"]
  },
  "include": ["examples/generated/*.ts"],
  "exclude": []
}

# Nuxt and API URLs
NUXT_PUBLIC_API_BASE=http://localhost:8788
NUXT_PUBLIC_EVE_IMAGE_BASE=https://images.evetech.net
WEB_ORIGIN=http://localhost:3000

# PostgreSQL running through OrbStack / Docker Compose
POSTGRES_DB=eve_space
POSTGRES_USER=eve_space
POSTGRES_PASSWORD=eve_space
POSTGRES_PORT=5432
DATABASE_URL=postgres://eve_space:eve_space@localhost:5432/eve_space

# Durable BullMQ queue/coordination Redis. Keep separate from any disposable cache Redis.
QUEUE_REDIS_PORT=6379
# The Compose queue Redis process enforces this ceiling with no eviction.
QUEUE_REDIS_MAXMEMORY=512mb
# Zod owns these defaults. Uncomment only to override them for a worker run on the host.
# QUEUE_REDIS_URL=redis://localhost:6379
# QUEUE_COMPLETED_RETENTION_AGE_SECONDS=86400
# QUEUE_COMPLETED_RETENTION_COUNT=1000
# QUEUE_FAILED_RETENTION_AGE_SECONDS=604800
# QUEUE_FAILED_RETENTION_COUNT=5000
# QUEUE_OPERATION_CONCURRENCY=10
# QUEUE_HIGH_WATER_MARK=1000
# QUEUE_PLANNER_SCHEDULE=*/15 * * * *
# PostgreSQL generates and persists a random per-installation offset by default. Set this only for
# an explicit override; every worker replica in one deployment must receive the same value.
# QUEUE_PLANNER_SCHEDULE_OFFSET_MS=30000
# Each planner-produced job receives an additional independently sampled first-dispatch delay. The
# offset plus this maximum must remain shorter than the planner schedule interval.
# QUEUE_PLANNER_INITIAL_DELAY_MAX_MS=60000
# Oldest waiting job age at which /api/status reports the queue degraded. Tune against the planner
# schedule and typical job duration.
# QUEUE_LAG_DEGRADED_SECONDS=300
# Worker liveness beat. The Redis key TTL and the /api/status staleness window are both derived from
# it, so they cannot drift apart.
# WORKER_HEARTBEAT_INTERVAL_MS=15000
# Budget for the whole worker shutdown, not just draining. It must stay below the Compose
# stop_grace_period, or the process is killed before it can drop its queue connections.
# WORKER_SHUTDOWN_TIMEOUT_MS=30000
# Identifies one worker replica's heartbeat, so a healthy replica cannot mask a stuck sibling's
# container healthcheck. Defaults to the container hostname; set it only when running several
# workers outside Compose, where hostnames may collide.
# WORKER_ID=

# Scaling knobs. Zod owns these defaults too; they are the values to revisit when the deployment
# grows beyond one API replica or leaves a low-latency region.
#
# Pooled PostgreSQL connections per process. Budget against the server's max_connections divided by
# (API replicas + workers); the worker keeps its own pool.
# DATABASE_POOL_MAX=10
# Budget for a single EVE SSO leg. Discovery and JWKS each get half of it, so one token refresh
# holds the per-character advisory lock for at most twice this value.
# EVE_SSO_TIMEOUT_MS=15000
# Must exceed 2 x EVE_SSO_TIMEOUT_MS, or a second replica aborts instead of waiting for the winner
# to publish its rotated token. Rejected at startup otherwise.
# TOKEN_REFRESH_LOCK_TIMEOUT_MS=45000
# Concurrent refreshes per process. Must stay below DATABASE_POOL_MAX, because each one occupies a
# pooled connection across its SSO calls. Rejected at startup otherwise.
# TOKEN_REFRESH_CONCURRENCY=4
# How long a request waits for a refresh slot before returning 503 rather than hanging.
# TOKEN_REFRESH_QUEUE_TIMEOUT_MS=30000
# Entries retained per in-memory ESI cache: the dominant per-process memory knob. Lower it on small
# containers; the corporation and negative-lookup caches scale from it.
# ESI_CACHE_MAX_ENTRIES=100

# Register this exact callback in the EVE Developer Portal.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_CALLBACK_URL=http://localhost:8788/auth/eve/callback
EVE_SCOPES=esi-wallet.read_character_wallet.v1 esi-location.read_location.v1 esi-location.read_ship_type.v1 esi-skills.read_skills.v1
ESI_USER_AGENT=EveSpace/0.1 (eve:your-character) @evespace/esi-client/2.0.0

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# One-time deployment bootstrap gate. Generate with: openssl rand -base64 32
ADMIN_SETUP_SECRET=
SESSION_COOKIE_SECURE=false

{
  "name": "@eve-space/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "build": "pnpm build:dependencies && tsc",
    "build:dependencies": "pnpm --filter @evespace/esi-client build && pnpm --filter @eve-space/platform-module-contract build && pnpm --filter @eve-space/platform-module-server build && tsx ../scripts/run-installed-module-package-script.ts server build",
    "dev": "tsx src/db/migrate.ts && tsx watch src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "esi:rates": "tsx --env-file=../.env src/commands/report-esi-call-rates.ts",
    "outbox:redrive": "tsx src/commands/redrive-domain-events.ts",
    "db:studio": "drizzle-kit studio",
    "start": "node dist/db/migrate.js && node dist/server.js",
    "start:container": "node dist/db/migrate.js && node dist/server.js",
    "start:worker": "node dist/worker.js",
    "worker:health": "node dist/worker/health.js",
    "worker:rollback:verify": "tsx src/commands/verify-worker-rollback.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:packaging": "vitest run --config vitest.packaging.config.ts",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "test:postgres:coverage": "vitest run --config vitest.postgres.config.ts --coverage",
    "test:redis": "vitest run --config vitest.redis.config.ts --coverage",
    "typecheck": "pnpm build:dependencies && pnpm --filter @eve-space/platform-module-server typecheck && tsx ../scripts/run-installed-module-package-script.ts server typecheck && tsc --noEmit && tsc --project tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@eve-space/platform-module-contract": "workspace:*",
    "@eve-space/platform-module-server": "workspace:*",
    "@evespace/esi-client": "workspace:*",
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "ioredis": "catalog:",
    "jose": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:vitest4",
    "drizzle-kit": "catalog:",
    "testcontainers": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:tsgo",
    "vitest": "catalog:vitest4"
  }
}

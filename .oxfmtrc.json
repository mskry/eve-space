{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".claude/**",
    ".nuxt/**",
    ".opencode/**",
    ".output/**",
    "coverage/**",
    "**/coverage/**",
    "coverage-redis/**",
    "**/coverage-redis/**",
    "dist/**",
    "**/dist/**",
    "node_modules/**",
    "openspec/**",
    "pnpm-lock.yaml",
    "sde-ingest/target/**"
  ],
  "printWidth": 100,
  "proseWrap": "preserve",
  "semi": false,
  "singleQuote": true,
  "sortPackageJson": false,
  "trailingComma": "all"
}

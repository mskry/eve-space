:{$PORT:8080} {
	encode zstd gzip

	@health path /health
	handle @health {
		header Content-Type application/json
		respond `{"status":"ok"}` 200
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM}
	}

	handle /auth/* {
		reverse_proxy {$API_UPSTREAM}
	}

	handle {
		reverse_proxy {$WEB_UPSTREAM}
	}
}

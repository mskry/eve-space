{
  "name": "eve-space",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:api": "pnpm --filter @eve-space/api dev",
    "db:migrate": "pnpm --filter @eve-space/api migrate",
    "db:studio": "pnpm --filter @eve-space/api db:studio",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "sde:ingest": "cargo run --release --manifest-path sde-ingest/Cargo.toml --",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "knip": "knip",
    "stack:up": "docker compose up --build -d",
    "stack:down": "docker compose down",
    "test:frontend": "vitest run --config vitest.config.ts",
    "test:frontend:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:api": "pnpm --filter @eve-space/api test",
    "typecheck": "nuxt typecheck && pnpm --filter @eve-space/api typecheck",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && lefthook install"
  },
  "dependencies": {
    "@pinia/colada": "^1.4.2",
    "@pinia/colada-nuxt": "^1.0.2",
    "@pinia/colada-plugin-retry": "^1.0.2",
    "@pinia/nuxt": "^1.0.2",
    "fuse.js": "^7.1.0",
    "hono": "^4.13.3",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.3",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.1.0",
    "@pinia/colada-devtools": "^1.1.2",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "devalue": "^5.9.0",
    "happy-dom": "^20.11.2",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "msw": "^2.15.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.10"
  }
}

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        // Resolved by path at build time by @pinia/colada-nuxt, never imported.
        "colada.options.ts",
        // Ambient module augmentation, picked up by tsconfig include rather than an import.
        "app/types/**/*.d.ts",
        // Nuxt layer: auto-registered components and auto-imported composables/plugins.
        "layers/*/nuxt.config.ts",
        "layers/*/app/components/**/*.vue",
        "layers/*/app/{composables,plugins,utils}/**/*.ts",
        "features/organization-activity/module.config.ts",
        "generated/platform/*.ts",
        "scripts/copy-platform-nuxt-runtime-assets.mjs",
        "scripts/module-registry/source-extensions.d.mts",
        "tests/fixtures/platform-module-conformance/{nuxt.config.ts,api/src/index.ts,app/**/*.{ts,vue}}",
        "tests/fixtures/platform-module-conformance/features/conformance/module.config.ts",
        "tests/fixtures/platform-module-conformance/features/conformance/server/src/index.ts",
        "tests/fixtures/platform-module-conformance/features/conformance/nuxt/src/{module.ts,runtime/app/pages/**/*.vue}",
        "vitest.conformance.config.ts",
      ],
      // vue-tsc is invoked by Nuxt; Pinia modules are selected through generated registries.
      // The remaining dependencies belong to fixture manifests outside the pnpm workspace graph.
      "ignoreDependencies": [
        "vue-tsc",
        "@pinia/colada-nuxt",
        "@pinia/nuxt",
        "@hono/zod-validator",
        "@nuxt/schema",
        "zod",
      ],
    },
    "api": {
      // Process roots. `AppType` in src/index.ts is consumed by the Nuxt workspace rather than by
      // the API itself; the worker pair is reached through package scripts that point at `dist`,
      // which knip cannot resolve back to source.
      "entry": [
        "src/index.ts",
        "src/worker.ts",
        "src/worker/health.ts",
        "src/generated/platform/*.ts",
        "tests/fixtures/platform-module/*.ts",
        "tests/**/*.types.ts",
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
    },
    "features/organization-activity/server": {
      "entry": ["src/schema.ts"],
    },
    "features/organization-activity/nuxt": {
      "entry": [
        "src/runtime/app/pages/OrganizationActivityCampaignPage.vue",
        "src/runtime/app/pages/OrganizationActivityJobPage.vue",
        "src/runtime/app/pages/OrganizationActivityProjectPage.vue",
        "test/fixtures/basic/nuxt.config.ts",
      ],
    },
    "packages/esi-client": {
      // Generated artifacts and generator helpers are validated by this package's dedicated suite.
      "entry": ["{src,scripts,tests,examples}/**/*.{ts,js}"],
      "project": ["{src,scripts,tests,examples}/**/*.{ts,js}"],
    },
    "packages/platform-module-contract": {
      "project": ["src/**/*.ts"],
    },
    "packages/platform-module-server": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "packages/platform-module-nuxt": {
      "entry": [
        // Imported by a generated Nuxt type template through a resolved filesystem path.
        "src/runtime/config.ts",
        "src/runtime/app/{composables,middleware}/**/*.ts",
        "test/**/*.test.ts",
        "test/fixtures/*/{app.vue,app/**/*.{ts,vue}}",
        "test/fixtures/*/modules/*/src/**/*.{js,ts,vue}",
        "test/fixtures/*/nuxt.config.ts",
      ],
      "project": ["src/**/*.ts", "test/**/*.{ts,js,vue}"],
    },
  },
}
